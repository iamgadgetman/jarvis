<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.gadgetman</groupId>
    <artifactId>jarvis</artifactId>
    <version>0.10.3</version>
    <packaging>jar</packaging>

    <name>Jarvis</name>
    <description>Jarvis AI Butler for Minecraft</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Server API compiled against by default: Purpur 26.2 (primary target).
             The legacy-check profile swaps in the 1.21.8 API as a floor check. -->
        <server.api.version>26.2.build.2622-stable</server.api.version>
        <!-- GraalJS runs the model-written build scripts. Supplied at runtime by
             Paper's libraries: loader (see plugin.yml), so the scope is provided
             and the jar stays ~1 MB instead of ~60 MB. The shade-graaljs profile
             bundles it instead, for a server that cannot resolve it at start. -->
        <graaljs.version>25.3.4.1</graaljs.version>
        <graaljs.scope>provided</graaljs.scope>
    </properties>

    <repositories>
        <repository>
            <id>purpur</id>
            <url>https://repo.purpurmc.org/snapshots</url>
        </repository>
        <repository>
            <id>citizens</id>
            <url>https://maven.citizensnpcs.co/repo</url>
        </repository>
        <repository>
            <id>enginehub</id>
            <url>https://maven.enginehub.org/repo/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.purpurmc.purpur</groupId>
            <artifactId>purpur-api</artifactId>
            <version>${server.api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>net.citizensnpcs</groupId>
            <artifactId>citizensapi</artifactId>
            <version>2.0.43-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.sk89q.worldedit</groupId>
            <artifactId>worldedit-bukkit</artifactId>
            <version>7.3.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.graalvm.polyglot</groupId>
            <artifactId>polyglot</artifactId>
            <version>${graaljs.version}</version>
            <scope>${graaljs.scope}</scope>
        </dependency>
        <dependency>
            <groupId>org.graalvm.js</groupId>
            <artifactId>js-language</artifactId>
            <version>${graaljs.version}</version>
            <scope>${graaljs.scope}</scope>
        </dependency>
        <dependency>
            <groupId>org.graalvm.truffle</groupId>
            <artifactId>truffle-runtime</artifactId>
            <version>${graaljs.version}</version>
            <scope>${graaljs.scope}</scope>
        </dependency>
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>20231013</version>
        </dependency>
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>5.1.0</version>
        </dependency>
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>2.2</version>
        </dependency>
    </dependencies>

    <profiles>
        <!-- mvn -Pshade-graaljs clean package : bundles GraalJS into the jar
             instead of resolving it at runtime. Produces a ~60 MB jar. Use this
             if Paper's library loader cannot reach Maven Central on your host. -->
        <profile>
            <id>shade-graaljs</id>
            <properties>
                <graaljs.scope>compile</graaljs.scope>
            </properties>
        </profile>

        <!-- mvn -Plegacy-check clean compile : verifies the code also compiles
             against the oldest supported server API (1.21.x floor). -->
        <profile>
            <id>legacy-check</id>
            <properties>
                <server.api.version>1.21.8-R0.1-SNAPSHOT</server.api.version>
            </properties>
        </profile>
    </profiles>

    <build>
        <resources>
            <!-- plugin.yml takes its version from the pom so the two can
                 never drift; everything else is copied verbatim. -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes><include>plugin.yml</include></includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes><exclude>plugin.yml</exclude></excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <!-- Bytecode targets Java 17 so the jar runs on 1.21.x (Java 21)
                         and 26.x (Java 25) servers alike. Build with JDK 25. -->
                    <release>17</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <finalName>jarvis-${project.version}</finalName>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.gadgetman</groupId>
    <artifactId>jarvis-parent</artifactId>
    <version>0.16.0</version>
    <packaging>pom</packaging>

    <name>Jarvis</name>
    <description>Jarvis AI Butler for Minecraft</description>

    <!--
        Module layout (see docs/dev/platform-interface.md):

          jarvis-core   the brain and the task logic. Declares no server API,
                        so a stray Bukkit or Minecraft import fails the build.
          jarvis-paper  the Paper / Purpur plugin. Shades jarvis-core into the
                        jar it ships, so operators still drop in one file.

        Build everything with `mvn clean package -DskipTests`. The plugin jar
        lands in jarvis-paper/target/jarvis-<version>.jar.
    -->
    <modules>
        <module>jarvis-core</module>
        <module>jarvis-paper</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Bytecode targets Java 17 so the jars run on 1.21.x (Java 21) and
             26.x (Java 25) servers alike. Build with JDK 21 or newer. -->
        <maven.compiler.release>17</maven.compiler.release>

        <junit.version>5.11.3</junit.version>
        <json.version>20231013</json.version>
        <hikaricp.version>5.1.0</hikaricp.version>
        <snakeyaml.version>2.2</snakeyaml.version>

        <!-- Server API compiled against by default: Purpur 26.2 (primary target).
             The legacy-check profile swaps in the 1.21.8 API as a floor check. -->
        <server.api.version>26.2.build.2622-stable</server.api.version>
        <!-- GraalJS runs the model-written build scripts. Supplied at runtime by
             Paper's libraries: loader (see plugin.yml), so the scope is provided
             and the jar stays ~1 MB instead of ~60 MB. The shade-graaljs profile
             bundles it instead, for a server that cannot resolve it at start. -->
        <graaljs.version>25.3.4.1</graaljs.version>
        <graaljs.scope>provided</graaljs.scope>
        <voicechat.api.version>2.6.20</voicechat.api.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.gadgetman</groupId>
                <artifactId>jarvis-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.json</groupId>
                <artifactId>json</artifactId>
                <version>${json.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zaxxer</groupId>
                <artifactId>HikariCP</artifactId>
                <version>${hikaricp.version}</version>
            </dependency>
            <dependency>
                <groupId>org.yaml</groupId>
                <artifactId>snakeyaml</artifactId>
                <version>${snakeyaml.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <profiles>
        <!-- mvn -Pshade-graaljs clean package : bundles GraalJS into the plugin
             jar instead of resolving it at runtime. Produces a ~60 MB jar. Use
             this if Paper's library loader cannot reach Maven Central on your host. -->
        <profile>
            <id>shade-graaljs</id>
            <properties>
                <graaljs.scope>compile</graaljs.scope>
            </properties>
        </profile>

        <!-- mvn -Plegacy-check clean compile : verifies the plugin also compiles
             against the oldest supported server API (1.21.x floor). -->
        <profile>
            <id>legacy-check</id>
            <properties>
                <server.api.version>1.21.8-R0.1-SNAPSHOT</server.api.version>
            </properties>
        </profile>
    </profiles>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Maven's default surefire predates JUnit 5 and would silently
                     run no tests at all. Pin one that knows about it. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>3.4.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.3.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>

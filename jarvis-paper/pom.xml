<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.gadgetman</groupId>
        <artifactId>jarvis-parent</artifactId>
        <version>0.16.0</version>
    </parent>

    <artifactId>jarvis-paper</artifactId>
    <packaging>jar</packaging>

    <name>Jarvis Paper</name>
    <description>The Paper / Purpur plugin: jarvis-core plus the Bukkit and Citizens adapter</description>

    <repositories>
        <repository>
            <id>purpur</id>
            <url>https://repo.purpurmc.org/snapshots</url>
        </repository>
        <repository>
            <id>citizens</id>
            <url>https://maven.citizensnpcs.co/repo</url>
        </repository>
        <repository>
            <id>enginehub</id>
            <url>https://maven.enginehub.org/repo/</url>
        </repository>
        <repository>
            <id>maxhenkel</id>
            <url>https://maven.maxhenkel.de/repository/public</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- The platform-free core, shaded into this jar so operators still
             drop in a single file. -->
        <dependency>
            <groupId>com.gadgetman</groupId>
            <artifactId>jarvis-core</artifactId>
        </dependency>

        <!--
            Tests. The combat doctrine is a pure function of its situation and
            was written that way on purpose, so the whole archery decision
            table can be exercised without a server, a world, or a mock. That
            is the only thing under test here. Anything needing a live Bukkit
            registry is verified by deploying it, not by pretending.
        -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.purpurmc.purpur</groupId>
            <artifactId>purpur-api</artifactId>
            <version>${server.api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>net.citizensnpcs</groupId>
            <artifactId>citizensapi</artifactId>
            <version>2.0.43-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.sk89q.worldedit</groupId>
            <artifactId>worldedit-bukkit</artifactId>
            <version>7.3.0</version>
            <scope>provided</scope>
        </dependency>
        <!--
            Simple Voice Chat. API only, and pinned to the version the servers
            actually run: the plugin is a soft dependency, so a Jarvis built
            against a newer API than the installed jar would load fine and then
            fail at the first call.
        -->
        <dependency>
            <groupId>de.maxhenkel.voicechat</groupId>
            <artifactId>voicechat-api</artifactId>
            <version>${voicechat.api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.graalvm.polyglot</groupId>
            <artifactId>polyglot</artifactId>
            <version>${graaljs.version}</version>
            <scope>${graaljs.scope}</scope>
        </dependency>
        <dependency>
            <groupId>org.graalvm.js</groupId>
            <artifactId>js-language</artifactId>
            <version>${graaljs.version}</version>
            <scope>${graaljs.scope}</scope>
        </dependency>
        <dependency>
            <groupId>org.graalvm.truffle</groupId>
            <artifactId>truffle-runtime</artifactId>
            <version>${graaljs.version}</version>
            <scope>${graaljs.scope}</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- The jar operators install keeps its historical name. -->
        <finalName>jarvis-${project.version}</finalName>
        <resources>
            <!-- plugin.yml takes its version from the pom so the two can
                 never drift; everything else is copied verbatim. -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes><include>plugin.yml</include></includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes><exclude>plugin.yml</exclude></excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.gadgetman</groupId>
        <artifactId>jarvis-parent</artifactId>
        <version>0.17.0</version>
    </parent>

    <artifactId>jarvis-core</artifactId>
    <packaging>jar</packaging>

    <name>Jarvis Core</name>
    <description>
        The platform-free part of Jarvis: the brain and the task logic. This
        module declares no server API on purpose. Anything that needs Bukkit,
        Citizens, Paper, Fabric, or Minecraft itself belongs in an adapter
        module, and an import of one here fails the build.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
        </dependency>
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
        </dependency>
        <!-- The polyglot API only, so ScriptBuildPlanner compiles. The JS
             engine itself is a runtime concern of the adapter: Paper's
             library loader fetches it, and the planner checks for it with
             Class.forName before touching it. -->
        <!-- Speech inside the process: whisper.cpp to listen, Piper to speak.
             Both carry their native libraries (Linux x86_64 and arm64, Windows
             x86_64, macOS), extracted on first use. -->
        <dependency>
            <groupId>io.github.givimad</groupId>
            <artifactId>whisper-jni</artifactId>
            <version>${whisper-jni.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.givimad</groupId>
            <artifactId>piper-jni</artifactId>
            <version>${piper-jni.version}</version>
        </dependency>
        <dependency>
            <groupId>org.graalvm.polyglot</groupId>
            <artifactId>polyglot</artifactId>
            <version>${graaljs.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The tests boot the whole of core on a fake platform, and the
             service record and build history want a database to write to.
             On a server the driver comes with it; here it comes with the tests. -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.1.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- The rule this module exists for: no server API on the classpath.
                 A transitive dependency that dragged one in would let a stray
                 import compile, so the ban is on the dependency tree itself. The
                 NoPlatformImportsTest checks the sources the same way. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>no-platform-dependencies</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>io.papermc.paper:*</exclude>
                                        <exclude>io.papermc:*</exclude>
                                        <exclude>org.purpurmc.purpur:*</exclude>
                                        <exclude>org.spigotmc:*</exclude>
                                        <exclude>org.bukkit:*</exclude>
                                        <exclude>net.citizensnpcs:*</exclude>
                                        <exclude>com.sk89q.worldedit:*</exclude>
                                        <exclude>net.kyori:*</exclude>
                                        <exclude>net.fabricmc:*</exclude>
                                        <exclude>net.minecraft:*</exclude>
                                        <exclude>de.maxhenkel.voicechat:*</exclude>
                                    </excludes>
                                    <message>jarvis-core must not depend on a server or mod API; that belongs in an adapter module.</message>
                                </bannedDependencies>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
